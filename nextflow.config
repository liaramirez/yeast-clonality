manifest {
    name            = 'yeast-clonality'
    description     = 'Genotype-based clonality assessment for heterozygous yeasts sequenced with Oxford Nanopore'
    version         = '0.1.0'
    nextflowVersion = '>=23.04.0'
    mainScript      = 'main.nf'
}

params {
    help           = false
    samplesheet    = null
    reference      = null
    outdir         = 'results'
    chunk_size     = 2000      // bp; 0 = keep reads as they are
    min_contig_len = 50000
    call_chunks    = 8
    min_qual       = 30
    min_dp         = 10
    max_dp_factor  = 2
    group          = null      // e.g. 'Lev_1,Lev_2,Lev_3,Lev_4,Lev_5'
    conda_env      = 'ani'     // micromamba environment with the tools (profile leftraru)
}

process {
    withLabel: process_single { cpus = 1; memory = 4.GB;  time = 6.h }
    withLabel: process_low    { cpus = 2; memory = 4.GB;  time = 2.h }
    withLabel: process_high   { cpus = 8; memory = 16.GB; time = 4.h }
    errorStrategy = { task.exitStatus in [134,135,137,139,140,143] ? 'retry' : 'terminate' }
    maxRetries    = 2
}

profiles {
    leftraru { includeConfig 'conf/leftraru.config' }
    local    { process.executor = 'local' }
    test     { includeConfig 'conf/test.config' }
}

report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
