// Quick structural test: nextflow run main.nf -profile test -stub
params {
    samplesheet = "${projectDir}/tests/samplesheet_test.csv"
    reference   = "${projectDir}/tests/ref_test.fa"
    outdir      = 'results_test'
    call_chunks = 2
}
process.executor = 'local'
process {
    withLabel: process_high { cpus = 1; memory = 1.GB }
    withLabel: process_low  { cpus = 1; memory = 1.GB }
    withLabel: process_single { memory = 1.GB }
}
