// Leftraru (NLHPC): SLURM + an existing micromamba environment
process {
    executor     = 'slurm'
    queue        = 'main'
    beforeScript = "eval \"\$(micromamba shell hook -s bash)\"; micromamba activate ${params.conda_env}"
}
executor {
    queueSize       = 8
    submitRateLimit = '10/1min'
}
